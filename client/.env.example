# Biarkan kosong saat development lokal (otomatis memakai proxy Vite ke http://localhost:5000)
# Saat deploy di Vercel, isi dengan URL publik backend Render (tanpa garis miring di akhir)
VITE_API_URL=

# Opsional: ubah ke true hanya jika ingin memakai mode simulasi offline tanpa backend
VITE_USE_MOCK=false
