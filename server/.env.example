PORT=5000
NODE_ENV=development

# Daftar origin frontend yang diizinkan (pisahkan dengan koma bila lebih dari satu)
# Contoh produksi: https://fritografi.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# Konfigurasi Zro API (OpenAI-compatible)
ZRO_BASE_URL=https://zro.moonmath.ai/v1
ZRO_MODEL=deepseek-v4.1-flash
ZRO_API_KEY=isi_api_key_zro_di_sini

# Konfigurasi Tavily Search API
TAVILY_API_KEY=isi_api_key_tavily_di_sini
